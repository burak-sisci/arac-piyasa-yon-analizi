# Dönüşüm çıktıları (docx/pptx/pdf) — git'e girmez
exports/

# Toplantı sunumları ve görsel çıktıları — yerelde kalır
sunumlar/

# Çekilen veri — git'e girmez (prompt/kod versiyonlanır, veri versiyonlanmaz;
# karar K5: yalnızca kamuya açık kaynaklar, şirket içi veri repoya girmez)
# Veri, kaynak adına göre alt klasörlere ayrılmıştır (data/raw/usdtry/,
# data/raw/tufe/ vb.) — yalnızca klasör yapısı (.gitkeep) versiyonlanır.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Alt klasörlerin kendisi görünür olsun (icine girilebilsin):
!data/raw/*/
!data/processed/*/
# ...ama icindeki HER SEY yine varsayilan olarak gizli kalsin:
data/raw/*/*
data/processed/*/*
# ...yalnizca .gitkeep'ler ve raporlar/ ile dataframes/ altindaki .md'ler istisna:
!data/raw/*/.gitkeep
!data/processed/*/.gitkeep
!data/processed/raporlar/*.md
!data/processed/dataframes/*.md

# Kaynak adına göre düz data/<kaynak>/ klasörleri (data/raw, data/processed
# dışında — modelleme fazı betiklerinin doğrudan yazdığı konumlar) — aynı
# kural (K5, veri versiyonlanmaz) burada da geçerli; yalnızca .gitkeep ve
# README.md istisna.
data/alim_gucu/*
data/altintry/*
data/arabamcom/*
data/betam/*
data/birlesik_target_setleri/*
data/birlesik_veri_seti/*
data/doas_stok_devir/*
data/enag/*
data/eurtry/*
data/faiz/*
data/indicata/*
data/noter_devir/*
data/odmd/*
data/odmd_oyder/*
data/osd/*
data/otv/*
data/proxy_fiyat/*
data/quickfinans_stokta_kalma/*
data/target_bazli_birlesik_setler/*
data/tokkder/*
data/trafige_kayitli_otomobiller/*
data/tufe/*
data/tuketici_guveni/*
data/usdtry/*
!data/*/.gitkeep
!data/*/README.md

# API anahtarları / gizli bilgiler — asla git'e girmez
.env

# Office/PowerPoint kilit dosyaları
~$*.docx
~$*.pptx
~$*.xlsx

# Python (pandoc/python-docx/python-pptx yardımcı scriptleri için)
__pycache__/
*.pyc
.venv/
venv/
# Modelleme fazı — AutoGluon TimeSeries icin ayri Python 3.12 sanal ortami
# (ana ortam 3.14, AutoGluon henuz desteklemiyor) - kod versiyonlanir, ortam degil.
.venv312/

# Jupyter (notebooks/ — .ipynb dosyalarının kendisi git'e girer, ama
# calisma zamani checkpoint klasoru gurultu, girmez)
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Editör
.vscode/
.idea/
# Yerel ajan proje bağlamı
CLAUDE.md
